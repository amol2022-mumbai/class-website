# Copy this file to .env and fill in your own values.
# The app never ships with or reads any API keys from the deployment platform -
# provide your own here or in your hosting control panel's environment variables.

# Optional: AI quiz generation (OpenAI-compatible API, e.g. DeepSeek, OpenAI, Groq)
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# Optional: SMS / WhatsApp reminders (Twilio-compatible). Without these, the app
# logs reminders as "simulated" so the workflow is still testable.
SMS_TWILIO_ACCOUNT_SID=your_account_sid
SMS_TWILIO_AUTH_TOKEN=your_auth_token
SMS_TWILIO_FROM=+15551234567

# Optional: auto fee-reminder hour (24h). The scheduler runs once per day at this
# hour and messages every due/overdue installment (max one per installment/day).
AUTO_REMINDER_HOUR=9

# Optional: Online fee payments (Razorpay, INR). Without these, "Pay Online"
# is hidden and fees are recorded offline only. Use your test keys (rzp_test_*)
# for development, live keys (rzp_live_*) in production.
USER_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
USER_RAZORPAY_KEY_SECRET=your_key_secret

# Optional: override the HTTP port
PORT=3001
